

Screen {
    background: #000000;
}

#app-container {
    height: 1fr;
    layout: vertical;
    background: #000000;
}

/* Main container - horizontal split */
#main-container {
    height: 1fr;
    layout: horizontal;
    background: #000000;
}

/* Task panel - left side */
#task-panel {
    width: 58;
    min-width: 42;
    max-width: 90;
    border: solid #007acc;
    border-title-align: center;
    border-title-color: #00bcd4;
    background: #000000;
    padding: 0 1;
}

#task-panel:focus {
    border: heavy #00d4ff;
    border-title-color: #00d4ff;
}

.section-title {
    text-align: center;
    text-style: bold;
    color: #00aaff;
    margin: 1 0 0 0;
}

/* Right container */
#right-container {
    width: 1fr;
    layout: vertical;
    background: #000000;
}

/* Messages panel - fills right space */
#messages-panel {
    height: 1fr;
    border: solid #007acc;
    border-title-align: center;
    border-title-color: #00bcd4;
    background: #000000;
    padding: 0 1;
}

#messages-panel:focus {
    border: heavy #00d4ff;
    border-title-color: #00d4ff;
}

/* Console container - bottom */
#console-container {
    height: 14;
    min-height: 8;
    max-height: 26;
    border: solid #d4a017;
    border-title-align: center;
    border-title-color: #ffc107;
    background: #000000;
    layout: vertical;
}

#console-container:focus-within {
    border: heavy #ffd54f;
    border-title-color: #ffd54f;
}

#console-output {
    height: 1fr;
    background: #000000;
    color: #a0c060;
    padding: 0 1;
}

#console-input-row {
    height: 3;
    layout: horizontal;
    border: solid #007acc;
    background: #000000;
    padding: 0;
}

#console-input-row:focus-within {
    border: heavy #ffaa00;
}

#console-prompt {
    width: auto;
    color: #00bcd4;
    text-style: bold;
    padding: 1 1 0 1;
    background: #000000;
}

#console-input {
    width: 1fr;
    height: 3;
    border: none;
    background: #000000;
    color: #ffffff;
    padding: 0 1;
}

#console-input:focus {
    border: none;
}

/* Status bar - bottom 1-line */
#status-bar {
    height: 1;
    background: #0a0a0a;
    color: #bbbbbb;
    layout: horizontal;
    padding: 0;
}

#status-left {
    width: 1fr;
    height: 1;
    padding: 0 1;
    content-align: left middle;
    color: #cccccc;
}

#status-hint {
    width: auto;
    height: 1;
    padding: 0 2;
    background: #008844;
    color: #ffffff;
    text-style: bold;
}

/* Splitters */
.splitter.vertical {
    width: 1;
    height: 1fr;
    background: #000000;
    color: #005588;
}

.splitter.horizontal {
    height: 1;
    width: 100%;
    background: #000000;
    color: #554400;
}
