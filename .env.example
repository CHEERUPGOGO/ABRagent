# AutoBatteryResearch Agent (ABRAgent) 环境变量配置模板
# 复制本文件为 .env 并填入您的真实密钥即可生效

# 1. 大模型 API 密钥配置 (支持 MiniMax / DeepSeek / OpenAI / Qwen / SiliconFlow 等)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7-highspeed

# 2. 本地 Ollama 向量嵌入配置 (默认连接本地 Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b

# 3. (可选) MinerU 云解析 Token
MINERU_TOKEN=

# 4. Materials Project 官方 MCP（安装: python -m pip install '.[mp]'）
# 由 FastMCP 按需启动官方 mp_api.mcp.server；无需手动启动后台服务。
MP_API_KEY=
MP_MCP_ENABLED=true
# 留空使用当前 Python；本机 chem 环境可填 E:/Chem/conda_env/chem/python.exe
MP_MCP_PYTHON=
MP_MCP_TIMEOUT=120
MP_MCP_MAX_RESULTS=3
