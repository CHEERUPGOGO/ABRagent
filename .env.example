# ABRAgent 环境变量样例 — 复制本文件为 .env 后按需填写。
# 优先级: 已有系统环境变量 > .env > setting.yaml 内置默认值 (不会覆盖已导出的变量)。

# ---- LLM 后端 (OpenAI 兼容协议: MiniMax / DeepSeek / Qwen / OpenAI / Ollama) ----
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7-highspeed

# ---- MinerU 云解析 (仅 Stage 1 新增 PDF -> Markdown 时需要；已有文献资产不触发) ----
# 也可写入 preprocessing/config.yaml 的 mineru.token 字段
MINERU_TOKEN=

# ---- 本地 Ollama (Stage 2/4 向量检索；不可用时自动降级 TF-IDF/BM25) ----
# 模型拉取: ollama pull qwen3-embedding:8b
# OLLAMA_HOST=http://localhost:11434
