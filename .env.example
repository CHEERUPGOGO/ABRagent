# AutoBatteryResearch Agent (ABRAgent) 环境变量配置模板
# 复制本文件为 .env 并填入您的真实密钥即可生效

# 1. 大模型 API 密钥配置 (支持 MiniMax / DeepSeek / OpenAI / Qwen / SiliconFlow 等)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7-highspeed

# 2. 本地 Ollama 向量嵌入配置 (默认连接本地 Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b

# 3. (可选) MinerU 云解析 Token
MINERU_TOKEN=
